APP_NAME=Laravel
# WhatsApp del salón para la página pública, solo dígitos (ej. 595981123456). Vacío: sin botón
SALON_WHATSAPP=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Asuncion

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=menina_coiffure
DB_USERNAME=menina
DB_PASSWORD=menina123

# Demo del balanceo (/balanceo y su ping). Sin definir: activo en desarrollo, apagado en producción
# APP_DEMO=true

# Correo de la dueña que recibe el aviso al llegar un pedido de cita (vacío: sin aviso).
# Se prueba con: php artisan correo:probar
AVISOS_CORREO_DESTINO=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correos (avisos a la dueña y recuperación de contraseña). Con 'log' solo se escriben en
# storage/logs/laravel.log. Para enviarlos con Gmail: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com,
# MAIL_PORT=587, MAIL_USERNAME y MAIL_FROM_ADDRESS con la cuenta de Gmail y en MAIL_PASSWORD una
# "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Menina Coiffure"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
