# Variables de producción. Copiar a deploy/.env.production (que NO se sube a Git) y completar.
# Contraseñas: generarlas con 'openssl rand -hex 32'. Evitar el signo $: Docker Compose lo interpreta.

# --- Compose (Caddy y HAProxy) ---
DOMINIO=meninacoiffure.com
# Correo al que Let's Encrypt avisa si un certificado no se puede renovar
ACME_EMAIL=correo-del-equipo@gmail.com
HAPROXY_STATS_PASSWORD=cambiar-por-una-larga

# --- Laravel ---
APP_NAME="Menina Coiffure"
APP_ENV=production
# Se genera con: docker compose -f docker-compose.prod.yml --env-file deploy/.env.production run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# true solo para la demo de /balanceo (Avance 4). En el día a día, false
APP_DEMO=false
APP_URL=https://meninacoiffure.com
APP_TIMEZONE=America/Asuncion
# 'en' a propósito: Laravel no trae traducciones al español y los mensajes que ven las usuarias ya
# están escritos en español en el código. Con 'es' algunos errores saldrían como 'validation.required'
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Número de WhatsApp del salón para la página pública (solo dígitos, con 595)
SALON_WHATSAPP=
# Modo mantenimiento compartido por los dos nodos (con 'file' solo afectaría a uno)
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Usuario de la app: SIN superusuario. Se crea solo al crear la base (deploy/postgres/)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=menina_coiffure
DB_USERNAME=menina_app
DB_PASSWORD=cambiar-por-una-larga

# Superusuario de PostgreSQL: solo para backups, restauraciones y administración. Otro nombre y
# OTRA contraseña que DB_*: deploy.sh no despliega si coinciden. La app no recibe esta contraseña
POSTGRES_DB=menina_coiffure
POSTGRES_USER=menina
POSTGRES_PASSWORD=cambiar-por-otra-larga

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# Correo (avisos a la dueña y recuperación de contraseña) por Brevo: SMTP y API > SMTP.
# Puerto 465 con smtps: TLS desde el primer byte. Con 587 el cifrado se negocia y, si alguien en el
# camino lo borra, la contraseña viajaría sin cifrar
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_SCHEME=smtps
# El "Login" que muestra Brevo (termina en @smtp-brevo.com), no el Gmail del salón
MAIL_USERNAME=login@smtp-brevo.com
MAIL_PASSWORD=clave-smtp-de-brevo
# Segundos máximos esperando a Brevo: si tarda más, se abandona y el proceso de PHP queda libre
MAIL_TIMEOUT=10
# El remitente confirmado en Brevo (Senders)
MAIL_FROM_ADDRESS=correo-del-salon@gmail.com
MAIL_FROM_NAME="Menina Coiffure"
AVISOS_CORREO_DESTINO=correo-de-la-duena@gmail.com
