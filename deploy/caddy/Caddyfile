# Caddy: única entrada desde internet. Pide y renueva el certificado de Let's Encrypt solo,
# redirige http a https y le pasa todo a HAProxy. Las variables vienen de deploy/.env.production
{
	# Let's Encrypt avisa a este correo si un certificado no se puede renovar
	email {$ACME_EMAIL}
}

{$DOMINIO} {
	encode zstd gzip

	# El navegador recuerda por un año que este sitio va siempre por https
	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy haproxy:80 {
		# Caddy reescribe X-Forwarded-For, -Proto y -Host, pero el resto pasaría tal cual lo manda el
		# cliente. Laravel ya las ignora; se borran acá también por si alguien cambia esa configuración
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Server
		header_up -Forwarded
	}
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
